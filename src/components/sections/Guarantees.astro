---
/**
 * Garantias do processo.
 *
 * Esta seção existe por uma razão específica e vale registrar: a NivoTech
 * ainda não me forneceu depoimentos, logos de clientes nem métricas
 * auditáveis, e inventar qualquer um dos três seria risco jurídico e de
 * reputação. Enquanto `DEPOIMENTOS` e `METRICAS` estiverem vazios em
 * content.ts, é esta seção que faz o trabalho de construir confiança.
 *
 * A diferença é que aqui nada precisa de prova de terceiro: são compromissos
 * sobre o próprio processo, que o cliente verifica ao contratar.
 *
 * Quando a prova social real existir, ela ENTRA SOMANDO — esta seção continua
 * fazendo sentido ao lado dela.
 */
import Section from '../ui/Section.astro';
import SectionHeader from './SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { GARANTIAS } from '../../data/content';
---

<Section id="garantias" labelledby="garantias-titulo" surface="surface-2" divider>
  <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <SectionHeader
      id="garantias-titulo"
      eyebrow="Sem letra miúda"
      title="O que combinamos por escrito antes de começar"
      lead="Contratar um fornecedor de site envolve confiança em alguém que você ainda não conhece. Estes quatro pontos existem para reduzir esse risco do seu lado."
      class="max-w-none lg:sticky lg:top-28 lg:self-start"
    />

    <ul role="list" class="grid gap-4 sm:grid-cols-2" data-reveal-stagger>
      {
        GARANTIAS.map((g) => (
          <li class="card relative flex flex-col p-6">
            <span
              aria-hidden="true"
              class="grid size-9 place-items-center rounded-full bg-success/12 text-success"
            >
              <Icon name="check" size={17} />
            </span>
            <h3 class="mt-4 font-display text-base font-600 leading-snug text-ink">
              {g.titulo}
            </h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-2">
              {g.texto}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
