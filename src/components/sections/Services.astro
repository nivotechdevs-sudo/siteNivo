---
/**
 * Serviços.
 *
 * Cada cartão é um link inteiro para a página de serviço — não um cartão com
 * um "saiba mais" minúsculo no canto. Aumenta a área clicável (importa muito
 * no toque) e concentra o sinal de link interno num destino só.
 *
 * SEO: são os principais links internos da home para as páginas pillar. O
 * texto âncora é o nome real do serviço, que é também a palavra-chave alvo.
 */
import Section from '../ui/Section.astro';
import SectionHeader from './SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { SERVICOS } from '../../data/content';
---

<Section id="servicos" labelledby="servicos-titulo">
  <SectionHeader
    id="servicos-titulo"
    eyebrow="O que fazemos"
    title="Duas frentes, o mesmo padrão de engenharia"
    lead="Não fazemos de tudo um pouco. Fazemos sites e landing pages, e fazemos com profundidade técnica que trabalho generalista não alcança."
  />

  <div class="mt-14 grid gap-5 lg:grid-cols-2" data-reveal-stagger>
    {
      SERVICOS.map((servico) => (
        <article class="card card--interactive spotlight group relative flex flex-col p-7 sm:p-9">
          <span
            aria-hidden="true"
            class="grid size-11 place-items-center rounded-lg bg-brand-subtle text-brand-subtle-ink"
          >
            <Icon name={servico.icone} size={21} />
          </span>

          <h3 class="mt-6 font-display text-display-sm text-ink">
            {/* O link cobre o cartão inteiro via ::after. A área clicável
                cresce sem aninhar elementos interativos, o que seria
                inválido e quebraria a navegação por teclado. */}
            <a
              href={`/servicos/${servico.slug}/`}
              class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
            >
              {servico.nome}
              <span class="sr-only"> — {servico.titulo}</span>
            </a>
          </h3>

          <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-2">
            {servico.promessa}
          </p>

          <ul role="list" class="mt-6 flex flex-col gap-2.5">
            {servico.entregaveis.slice(0, 4).map((item) => (
              <li class="flex items-start gap-2.5 text-[0.9375rem] text-ink-2">
                <Icon name="check" size={16} class="mt-1 shrink-0 text-brand" />
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <p
            class="mt-7 inline-flex items-center gap-2 text-[0.9375rem] font-600 text-brand"
            aria-hidden="true"
          >
            Ver detalhes do serviço
            <Icon
              name="arrow-right"
              size={17}
              class="transition-transform duration-300 ease-[var(--ease-out-expo)] group-hover:translate-x-1"
            />
          </p>

          {/* Anel de foco do cartão: o link real não tem contorno próprio
              (ele é invisível), então o cartão precisa mostrar o foco. */}
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 rounded-[inherit] ring-2 ring-focus ring-offset-2 ring-offset-canvas opacity-0 transition-opacity group-has-[a:focus-visible]:opacity-100"
          />
        </article>
      ))
    }
  </div>
</Section>
