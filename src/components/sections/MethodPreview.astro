---
/**
 * Prévia do método na home.
 *
 * Mostra as seis etapas de forma compacta e leva para /metodo/. Reduzir a
 * incerteza sobre "como isso vai funcionar" é um dos maiores destravadores
 * de conversão em serviço de ticket alto — a pessoa não está só comprando um
 * site, está comprando meses de convivência com um fornecedor.
 *
 * A linha que conecta as etapas é `border`, não elemento posicionado: não
 * gera nó extra e não corre risco de desalinhar no responsivo.
 */
import Section from '../ui/Section.astro';
import SectionHeader from './SectionHeader.astro';
import Button from '../ui/Button.astro';
import { METODO } from '../../data/content';
---

<Section id="metodo" labelledby="metodo-titulo">
  <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHeader
        id="metodo-titulo"
        eyebrow="Método"
        title="Você sabe o que acontece em cada etapa"
        lead="Projeto de site trava por falta de clareza, não por falta de talento. Por isso cada etapa tem entregável definido e critério de aceite combinado antes de começar."
        class="max-w-none"
      />

      <div class="mt-8" data-reveal>
        <Button href="/metodo/" variant="secondary" icon="arrow-right" dataCta="home-metodo">
          Ver o método completo
        </Button>
      </div>
    </div>

    <ol role="list" class="timeline">
      {/* Trilho e progresso.
          O trilho é a linha cinza contínua; o progresso é a linha na cor da
          marca que a preenche conforme a lista atravessa a viewport.

          Usa `animation-timeline: view()`, que o navegador resolve no
          compositor: nenhum listener de rolagem, nenhum trabalho por quadro
          na thread principal. É a diferença entre uma interação de rolagem
          que custa zero e uma que derruba o INP. Onde a API não existe, o
          progresso simplesmente não aparece e o trilho fica — degradação
          sem nada quebrado. */}
      <span aria-hidden="true" class="timeline__track"></span>
      <span aria-hidden="true" class="timeline__fill"></span>

      {
        METODO.map((etapa, i) => (
          <li
            class="timeline__item"data-index={i}
            data-reveal
            style={`--reveal-delay:${i * 50}ms`}
          >
            {/* Número da etapa, ancorado sobre a linha. */}
            <span
              aria-hidden="true"
              class="timeline__dot"
            >
              {etapa.numero}
            </span>

            <h3 class="font-display text-display-sm text-ink">
              {etapa.titulo}
            </h3>

            <p class="mt-2 text-[1.0625rem] leading-relaxed text-ink-2">
              {etapa.resumo}
            </p>

            <p class="mt-3 inline-flex items-start gap-2 rounded-md bg-surface-2 px-3 py-2 text-[0.8125rem] leading-relaxed text-ink-2">
              <span class="font-600 text-ink">Entrega:</span>
              {etapa.entregavel}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Trilho: a linha cinza que liga todas as etapas. Para antes do centro do
     último marcador, senão sobraria um traço apontando para o nada. */
  .timeline__track,
  .timeline__fill {
    position: absolute;
    left: 0;
    top: 0.9375rem;
    bottom: calc(100% - 0.9375rem);
    width: 1px;
    pointer-events: none;
  }

  .timeline__track {
    bottom: auto;
    height: calc(100% - 1.875rem - 2.25rem);
    background-color: var(--c-line);
  }

  /* Progresso: gradiente na cor da marca, revelado por `scaleY` ligado à
     posição da lista na viewport. Anima transform, nunca height — height
     por quadro dispararia layout na rolagem. */
  .timeline__fill {
    height: calc(100% - 1.875rem - 2.25rem);
    bottom: auto;
    background: linear-gradient(
      to bottom,
      var(--c-brand-vivid),
      color-mix(in oklab, var(--c-signal-solid) 70%, var(--c-brand-vivid))
    );
    transform: scaleY(0);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    .timeline__fill {
      animation: timeline-grow linear both;
      animation-timeline: view();
      /* Começa quando a lista entra e termina quando o topo dela chega ao
         topo da tela: acompanha a leitura, não a posição bruta da página. */
      animation-range: entry 55% cover 85%;
    }
  }

  @keyframes timeline-grow {
    to {
      transform: scaleY(1);
    }
  }

  .timeline__item {
    position: relative;
    padding-bottom: 2.25rem;
    padding-left: 2.75rem;
  }

  .timeline__item:last-child {
    padding-bottom: 0;
  }

  /* Marcador da etapa. Fundo opaco para cobrir o trilho que passa atrás. */
  .timeline__dot {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    transform: translateX(-50%);
    border-radius: 999px;
    border: 1px solid var(--c-line);
    background-color: var(--c-canvas);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--c-ink-3);
    transition:
      border-color 400ms var(--ease-out-quint),
      color 400ms var(--ease-out-quint),
      background-color 400ms var(--ease-out-quint);
  }

  /* O marcador acende quando a etapa entra no campo de leitura. Também por
     `view()`, então continua sem custo de JavaScript. */
  @supports (animation-timeline: view()) {
    .timeline__dot {
      animation: timeline-dot linear both;
      animation-timeline: view();
      animation-range: entry 70% entry 100%;
    }
  }

  @keyframes timeline-dot {
    to {
      border-color: var(--c-brand-vivid);
      color: var(--c-brand);
      background-color: var(--c-brand-subtle);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__fill {
      animation: none;
      transform: scaleY(1);
      opacity: 0.35;
    }

    .timeline__dot {
      animation: none;
      transition: none;
    }
  }
</style>
