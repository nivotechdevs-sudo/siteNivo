---
/**
 * Prévia do método na home.
 *
 * Mostra as seis etapas de forma compacta e leva para /metodo/. Reduzir a
 * incerteza sobre "como isso vai funcionar" é um dos maiores destravadores
 * de conversão em serviço de ticket alto — a pessoa não está só comprando um
 * site, está comprando meses de convivência com um fornecedor.
 *
 * A linha que conecta as etapas é `border`, não elemento posicionado: não
 * gera nó extra e não corre risco de desalinhar no responsivo.
 */
import Section from '../ui/Section.astro';
import SectionHeader from './SectionHeader.astro';
import Button from '../ui/Button.astro';
import { METODO } from '../../data/content';
---

<Section id="metodo" labelledby="metodo-titulo">
  <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHeader
        id="metodo-titulo"
        eyebrow="Método"
        title="Você sabe o que acontece em cada etapa"
        lead="Projeto de site trava por falta de clareza, não por falta de talento. Por isso cada etapa tem entregável definido e critério de aceite combinado antes de começar."
        class="max-w-none"
      />

      <div class="mt-8" data-reveal>
        <Button href="/metodo/" variant="secondary" icon="arrow-right" dataCta="home-metodo">
          Ver o método completo
        </Button>
      </div>
    </div>

    <ol role="list" class="relative flex flex-col">
      {
        METODO.map((etapa, i) => (
          <li
            class:list={[
              'relative pb-9 pl-11 last:pb-0',
              // A linha vertical liga as etapas. A última não tem linha,
              // senão sobraria um traço apontando para o nada.
              i < METODO.length - 1 && 'border-l border-line',
            ]}
            data-reveal
            style={`--reveal-delay:${i * 50}ms`}
          >
            {/* Número da etapa, ancorado sobre a linha. */}
            <span
              aria-hidden="true"
              class="absolute -left-px top-0 grid size-[1.875rem] -translate-x-1/2 place-items-center rounded-full border border-line bg-canvas font-display text-[0.6875rem] font-700 tabular text-ink-3"
            >
              {etapa.numero}
            </span>

            <h3 class="font-display text-display-sm text-ink">
              {etapa.titulo}
            </h3>

            <p class="mt-2 text-[1.0625rem] leading-relaxed text-ink-2">
              {etapa.resumo}
            </p>

            <p class="mt-3 inline-flex items-start gap-2 rounded-md bg-surface-2 px-3 py-2 text-[0.8125rem] leading-relaxed text-ink-2">
              <span class="font-600 text-ink">Entrega:</span>
              {etapa.entregavel}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
