---
/**
 * Hero das páginas internas.
 *
 * Mais contido que o da home de propósito: quem chega aqui já demonstrou
 * interesse específico e quer a informação, não outro argumento de venda. O
 * trabalho deste bloco é situar (breadcrumb), confirmar que a pessoa chegou
 * no lugar certo (H1) e dar o próximo passo (CTA).
 */
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import ContourField from '../ui/ContourField.astro';

export interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  breadcrumbs?: readonly { name: string; url: string }[];
  /** Semente do campo de curvas — dá uma topografia própria a cada página. */
  seed?: number;
  align?: 'left' | 'center';
}

const {
  eyebrow,
  title,
  lead,
  breadcrumbs,
  seed = 3,
  align = 'left',
} = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 mask-fade opacity-70">
      <ContourField lines={7} seed={seed} />
    </div>
    <div class="absolute inset-0 bg-grid opacity-30 mask-fade-b"></div>
  </div>

  <div class="container-site">
    <div
      class:list={[
        'py-14 sm:py-20',
        align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl',
      ]}
    >
      {
        breadcrumbs && (
          <Breadcrumbs
            items={breadcrumbs}
            class:list={['mb-7', align === 'center' && 'flex justify-center']}
          />
        )
      }

      {
        eyebrow && (
          <p class:list={['eyebrow', align === 'center' && 'justify-center']}>
            {eyebrow}
          </p>
        )
      }

      {/* Sem `data-reveal`: este é o elemento LCP da página. Animar a entrada
          dele atrasaria a métrica sem ganho real de percepção. */}
      <h1 class:list={['text-display-xl text-balance', eyebrow ? 'mt-5' : '']}>
        {title}
      </h1>

      {
        lead && (
          <p class="mt-6 text-lead text-ink-2 text-pretty">
            {lead}
          </p>
        )
      }

      <div class:list={[align === 'center' && 'flex justify-center']}>
        <slot />
      </div>
    </div>
  </div>
</section>
