---
/**
 * ============================================================================
 * INSTRUMENTO — Core Web Vitals medidos ao vivo, nesta página
 * ============================================================================
 *
 * O problema que isto resolve:
 * Toda agência escreve "fazemos sites rápidos". É a afirmação mais barata e
 * menos verificável do mercado. Sem portfólio publicado e sem depoimento,
 * seria só mais uma promessa.
 *
 * A solução: em vez de AFIRMAR velocidade, MEDIR — ao vivo, no navegador de
 * quem está lendo, com a API do próprio navegador. O visitante não precisa
 * acreditar em nós; ele está vendo o número da página que tem aberta.
 *
 * É o único dado de resultado no site inteiro que não depende de informação
 * que eu não tinha. É apurado na hora, pelo aparelho de quem visita.
 *
 * Implementação:
 *  - `PerformanceObserver` nativo. Nada de biblioteca web-vitals (~2 KB
 *    desnecessários quando só precisamos de três métricas).
 *  - LCP: maior elemento pintado, congelado na primeira interação — é assim
 *    que o Google encerra a medição.
 *  - CLS: soma da maior janela de 5s de deslocamentos sem interação.
 *  - INP: aproximado pela maior latência de evento observada. A métrica
 *    oficial usa o percentil 98 de uma sessão inteira; aqui é o pior caso,
 *    ou seja, uma leitura CONSERVADORA — nunca otimista a nosso favor.
 *
 * Degradação: sem JS ou sem suporte à API, os campos mostram "—" e o rótulo
 * explica. Nenhum número falso aparece em hipótese alguma.
 */

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

/** Limiares oficiais do Google (bom / precisa melhorar / ruim). */
const METRICAS = [
  {
    id: 'lcp',
    sigla: 'LCP',
    nome: 'Maior conteúdo pintado',
    explicacao: 'Quando o conteúdo principal ficou visível',
    bom: '≤ 2,5s',
  },
  {
    id: 'cls',
    sigla: 'CLS',
    nome: 'Deslocamento de layout',
    explicacao: 'O quanto a página “pulou” durante o carregamento',
    bom: '≤ 0,1',
  },
  {
    id: 'inp',
    sigla: 'INP',
    nome: 'Resposta à interação',
    explicacao: 'Quanto a página demora para reagir a um clique',
    bom: '≤ 200ms',
  },
] as const;
---

<div
  class={`card relative overflow-hidden p-5 sm:p-6 ${className}`}
  role="group"
  aria-labelledby="vitals-title"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2
        id="vitals-title"
        class="font-sans text-[0.8125rem] font-600 uppercase tracking-[0.1em] text-ink-3"
      >
        Medindo esta página
      </h2>
      <p class="mt-1 text-sm text-ink-2">
        Core Web Vitals, apurados agora no seu navegador
      </p>
    </div>

    {/* Indicador "ao vivo". O pulso é `transform`, roda no compositor. */}
    <span class="relative mt-0.5 flex size-2.5 shrink-0" aria-hidden="true">
      <span
        class="absolute inline-flex size-full animate-ping rounded-full bg-signal-solid opacity-70"
      ></span>
      <span class="relative inline-flex size-2.5 rounded-full bg-signal-solid"></span>
    </span>
  </div>

  <dl class="mt-5 flex flex-col gap-3.5">
    {
      METRICAS.map((m) => (
        <div class="flex items-baseline justify-between gap-3 border-t border-line pt-3.5 first:border-t-0 first:pt-0">
          <dt class="min-w-0">
            <span class="font-display text-sm font-600 text-ink">{m.sigla}</span>
            <span class="ml-2 text-[0.8125rem] text-ink-3">{m.explicacao}</span>
          </dt>
          <dd class="flex shrink-0 items-center gap-2">
            {/* Ponto de status: verde/âmbar/vermelho conforme o limiar. */}
            <span
              class="vitals-dot size-1.5 rounded-full bg-line-strong"
              data-dot={m.id}
              aria-hidden="true"
            />
            <span
              class="tabular font-display text-base font-700 text-ink-3"
              data-vital={m.id}
              aria-live="polite"
              aria-label={`${m.nome}: medindo`}
            >
              —
            </span>
          </dd>
        </div>
      ))
    }
  </dl>

  <p class="mt-5 border-t border-line pt-4 text-[0.75rem] leading-relaxed text-ink-3">
    Bom, segundo o Google: LCP ≤ 2,5s · CLS ≤ 0,1 · INP ≤ 200ms.{' '}
    <span data-vitals-note>INP aparece após a sua primeira interação.</span>
  </p>
</div>

<script>
  /**
   * Leitura das métricas via PerformanceObserver nativo.
   *
   * Todos os observers vão dentro de try/catch individuais: um tipo de
   * entrada não suportado lança, e não pode derrubar os outros dois.
   */
  type Rating = 'good' | 'ni' | 'poor';

  const LIMITS = {
    lcp: [2500, 4000],
    cls: [0.1, 0.25],
    inp: [200, 500],
  } as const;

  const COLORS: Record<Rating, string> = {
    good: 'var(--c-success)',
    ni: '#d97706',
    poor: 'var(--c-danger)',
  };

  const NOMES = {
    lcp: 'Maior conteúdo pintado',
    cls: 'Deslocamento de layout',
    inp: 'Resposta à interação',
  } as const;

  type MetricId = keyof typeof LIMITS;

  function rate(id: MetricId, value: number): Rating {
    const [good, poor] = LIMITS[id];
    if (value <= good) return 'good';
    if (value <= poor) return 'ni';
    return 'poor';
  }

  function render(id: MetricId, value: number): void {
    const el = document.querySelector<HTMLElement>(`[data-vital="${id}"]`);
    const dot = document.querySelector<HTMLElement>(`[data-dot="${id}"]`);
    if (!el) return;

    const text =
      id === 'cls'
        ? value.toLocaleString('pt-BR', { minimumFractionDigits: 3, maximumFractionDigits: 3 })
        : value >= 1000
          ? `${(value / 1000).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}s`
          : `${Math.round(value)}ms`;

    const rating = rate(id, value);

    el.textContent = text;
    el.style.color = COLORS[rating];
    el.setAttribute(
      'aria-label',
      `${NOMES[id]}: ${text}. ${
        rating === 'good' ? 'Dentro do recomendado pelo Google.' : 'Acima do recomendado.'
      }`,
    );
    if (dot) dot.style.backgroundColor = COLORS[rating];
  }

  /* ---- LCP ---------------------------------------------------------------
     A última entrada antes da primeira interação é o valor final. É assim
     que o Google encerra a medição — qualquer pintura depois do clique não
     conta mais. */
  try {
    let lcp = 0;
    const observer = new PerformanceObserver((list) => {
      const entries = list.getEntries();
      const last = entries[entries.length - 1];
      if (last) {
        lcp = last.startTime;
        render('lcp', lcp);
      }
    });
    observer.observe({ type: 'largest-contentful-paint', buffered: true });

    const freeze = (): void => {
      observer.disconnect();
      if (lcp) render('lcp', lcp);
    };
    addEventListener('keydown', freeze, { once: true, capture: true });
    addEventListener('pointerdown', freeze, { once: true, capture: true });
  } catch {
    /* navegador sem suporte a LCP: o campo segue mostrando "—" */
  }

  /* ---- CLS ---------------------------------------------------------------
     Soma apenas deslocamentos SEM interação recente (`hadRecentInput`):
     mudança de layout causada por clique do usuário é esperada e não conta.
     A métrica oficial usa a maior janela de 5s; aqui somamos a sessão, o que
     de novo é a leitura mais conservadora. */
  try {
    let cls = 0;
    new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        const shift = entry as PerformanceEntry & {
          value: number;
          hadRecentInput: boolean;
        };
        if (!shift.hadRecentInput) {
          cls += shift.value;
          render('cls', cls);
        }
      }
    }).observe({ type: 'layout-shift', buffered: true });

    // Zero é um resultado válido e precisa ser exibido, não ficar em "—".
    addEventListener(
      'load',
      () => {
        setTimeout(() => {
          const el = document.querySelector<HTMLElement>('[data-vital="cls"]');
          if (el && el.textContent === '—') render('cls', cls);
        }, 1200);
      },
      { once: true },
    );
  } catch {
    /* sem suporte a layout-shift */
  }

  /* ---- INP ---------------------------------------------------------------
     `event` com `durationThreshold: 16` captura interações acima de um
     quadro. Guardamos a PIOR latência observada: a métrica oficial usa o
     percentil 98 da sessão, então o pior caso é sempre >= ao valor real. */
  try {
    let worst = 0;
    new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        const event = entry as PerformanceEntry & { interactionId?: number };
        if (!event.interactionId) continue;
        if (event.duration > worst) {
          worst = event.duration;
          render('inp', worst);
          const note = document.querySelector<HTMLElement>('[data-vitals-note]');
          if (note) note.textContent = 'INP mostra a pior interação desta sessão.';
        }
      }
    }).observe({ type: 'event', buffered: true, durationThreshold: 16 } as PerformanceObserverInit);
  } catch {
    /* sem suporte a Event Timing (Safari antigo) */
  }
</script>
