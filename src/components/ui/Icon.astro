---
/**
 * Ícones de traço, inline.
 *
 * Um sprite inline em vez de uma biblioteca de ícones: são ~15 ícones, e
 * importar um pacote inteiro para isso significaria dezenas de KB e uma
 * dependência a mais para manter. Cada ícone aqui custa menos de 200 bytes.
 *
 * Todos herdam `currentColor` e usam o mesmo grid de 24px com traço de 1.75,
 * então nunca destoam entre si.
 *
 * Acessibilidade: ícone é decoração por padrão (`aria-hidden`). Se ele for o
 * único conteúdo de um botão, passe `title` — aí vira imagem com nome
 * acessível.
 */
export interface Props {
  name:
    | 'arrow-right'
    | 'arrow-up-right'
    | 'check'
    | 'layers'
    | 'target'
    | 'gauge'
    | 'search'
    | 'eye'
    | 'shield'
    | 'accessibility'
    | 'code'
    | 'whatsapp'
    | 'mail'
    | 'plus'
    | 'sparkle'
    | 'chevron-down'
    | 'alert'
    | 'instagram'
    | 'linkedin'
    | 'youtube'
    | 'facebook';
  size?: number;
  class?: string;
  /** Torna o ícone significativo para leitores de tela. */
  title?: string;
}

const { name, size = 20, class: className = '', title } = Astro.props;

const PATHS: Record<Props['name'], string> = {
  'arrow-right': 'M5 12h14m-6-6 6 6-6 6',
  'arrow-up-right': 'M7 17 17 7M8 7h9v9',
  check: 'm4 12.5 5 5L20 6.5',
  layers: 'm12 2 9 5-9 5-9-5 9-5Zm9 10-9 5-9-5m18 5-9 5-9-5',
  target: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-4a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-4a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z',
  gauge: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2.1-5.1L18 6M3.5 19a10 10 0 1 1 17 0',
  search: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.3-4.3',
  eye: 'M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  shield: 'M12 22s8-3.5 8-10V5.5L12 2 4 5.5V12c0 6.5 8 10 8 10Zm-3-10.5 2 2 4-4',
  accessibility:
    'M12 5.5a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5ZM4.5 8 12 9.5 19.5 8M12 9.5V14m0 0-3 8m3-8 3 8',
  code: 'm8 6-6 6 6 6m8-12 6 6-6 6M14 3l-4 18',
  whatsapp:
    'M3 21l1.6-4.9A8.4 8.4 0 1 1 7.9 19.4L3 21Zm6.4-12.3c-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.4s-.9.9-.9 2.1.9 2.5 1 2.6c.1.2 1.7 2.7 4.2 3.7 2.1.8 2.5.7 3 .6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.2-.2-.5-.3l-1.8-.9c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.9-.1-.2 0-.4.1-.5l.4-.5c.1-.2.2-.3.3-.5 0-.2 0-.3-.1-.5l-.7-1.8Z',
  mail: 'M3 7.5A2.5 2.5 0 0 1 5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5v-9Zm.5.5 8.5 6 8.5-6',
  plus: 'M12 5v14M5 12h14',
  sparkle: 'M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4L12 3Zm7 9.5.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z',
  'chevron-down': 'm6 9 6 6 6-6',
  alert: 'M12 8v5m0 3h.01M10.3 3.9 2.4 17.4A2 2 0 0 0 4.1 20.4h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z',
  // Marcas: desenhadas no mesmo grid de 24px e com o mesmo peso de traço
  // dos demais, para não destoarem visualmente do conjunto.
  instagram:
    'M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm4.5 5.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm5-1.2h.01',
  linkedin:
    'M4.5 3.2a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6ZM3 9.4h3v11.4H3V9.4Zm6 0h2.9v1.6a3.5 3.5 0 0 1 3.1-1.8c2.8 0 4 1.8 4 4.7v6.9h-3v-6.2c0-1.6-.6-2.5-1.9-2.5-1.2 0-2.1.8-2.1 2.5v6.2H9V9.4Z',
  youtube:
    'M21.2 7.4a2.6 2.6 0 0 0-1.8-1.8C17.8 5.2 12 5.2 12 5.2s-5.8 0-7.4.4a2.6 2.6 0 0 0-1.8 1.8C2.4 9 2.4 12 2.4 12s0 3 .4 4.6a2.6 2.6 0 0 0 1.8 1.8c1.6.4 7.4.4 7.4.4s5.8 0 7.4-.4a2.6 2.6 0 0 0 1.8-1.8c.4-1.6.4-4.6.4-4.6s0-3-.4-4.6ZM10.1 15.1V8.9l5.2 3.1-5.2 3.1Z',
  facebook:
    'M14.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H17.7V3.6A21 21 0 0 0 15.3 3.5c-2.4 0-4 1.45-4 4.1v2.3H8.6V13h2.7v8h3.2Z',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`shrink-0 ${className}`}
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
>
  {title && <title>{title}</title>}
  <path d={PATHS[name]}></path>
</svg>
