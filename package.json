{
  "name": "nivotech-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NivoTech — engenharia de sites de alta conversao. Astro + TypeScript + Tailwind.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:paths": "astro build && node tools/preview-build.mjs",
    "check": "astro check",
    "audit": "node tools/audit.mjs",
    "a11y": "node tools/a11y.mjs",
    "interactions": "node tools/interactions.mjs",
    "measure": "node tools/measure.mjs",
    "checklist": "node --experimental-strip-types tools/checklist.mjs",
    "shots": "node tools/screenshot.mjs",
    "fonts": "python3 tools/subset-fonts.py",
    "assets": "node tools/generate-assets.mjs",
    "test": "node tools/audit.mjs && node tools/a11y.mjs && node tools/interactions.mjs",
    "verify": "astro check && astro build && npm test"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2"
  }
}
